{
  "name": "@symphony/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "generate:api": "orval --config orval.config.ts && prettier --write src/api/generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "orval": "^7.17.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
