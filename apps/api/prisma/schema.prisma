// Constitution naming: singular PascalCase models, camelCase fields, UUID ids,
// and datetime fields suffixed with AtUtc. Domain tables belong to their task.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PendingSignIn {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  googleAccountId   String    @unique
  googleName        String
  googleEmail       String
  lastActivityAtUtc DateTime  @default(now())
  createdAtUtc      DateTime  @default(now())
  updatedAtUtc      DateTime  @updatedAt
  sessions          Session[]

  @@index([lastActivityAtUtc], map: "idx_PendingSignIn_lastActivityAtUtc")
}

model Member {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  googleAccountId    String    @unique
  googleEmail        String
  displayName        String
  whatsappE164       String
  isAdultConfirmed   Boolean
  createdAtUtc       DateTime  @default(now())
  updatedAtUtc       DateTime  @updatedAt
  sessions           Session[]
  consents           Consent[]
  administeredCircles Circle[] @relation("CircleAdmin")
  createdCircles      Circle[] @relation("CircleCreator")
  modifiedCircles     Circle[] @relation("CircleModifier")
  circleMemberships   CircleMembership[]
  usageEvents         UsageEvent[]
}

model Circle {
  id                 String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  inviteCode         String? @unique
  adminMemberId      String? @db.Uuid
  isOwnerCreated     Boolean
  createdByAccountId String? @db.Uuid
  modifiedByAccountId String? @db.Uuid
  createdAtUtc       DateTime @default(now())
  updatedAtUtc       DateTime @updatedAt
  deletedAtUtc       DateTime?
  admin              Member? @relation("CircleAdmin", fields: [adminMemberId], references: [id], onDelete: SetNull)
  creator            Member? @relation("CircleCreator", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  modifier           Member? @relation("CircleModifier", fields: [modifiedByAccountId], references: [id], onDelete: SetNull)
  memberships        CircleMembership[]
  usageEventCircles  UsageEventCircle[]

  @@index([adminMemberId], map: "idx_Circle_adminMemberId")
  @@index([createdByAccountId], map: "idx_Circle_createdByAccountId")
  @@index([modifiedByAccountId], map: "idx_Circle_modifiedByAccountId")
}

model CircleMembership {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  circleId     String @db.Uuid
  memberId     String @db.Uuid
  joinedAtUtc  DateTime @default(now())
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  circle       Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  member       Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([circleId, memberId])
  @@index([circleId], map: "idx_CircleMembership_circleId")
  @@index([memberId], map: "idx_CircleMembership_memberId")
}

model UsageEvent {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String
  memberId     String? @db.Uuid
  occurredAtUtc DateTime @default(now())
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  member       Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  circles      UsageEventCircle[]

  @@index([memberId], map: "idx_UsageEvent_memberId")
  @@index([type], map: "idx_UsageEvent_type")
  @@index([occurredAtUtc], map: "idx_UsageEvent_occurredAtUtc")
}

model UsageEventCircle {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  usageEventId String @db.Uuid
  circleId     String @db.Uuid
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  usageEvent   UsageEvent @relation(fields: [usageEventId], references: [id], onDelete: Cascade)
  circle       Circle @relation(fields: [circleId], references: [id])

  @@unique([usageEventId, circleId])
  @@index([usageEventId], map: "idx_UsageEventCircle_usageEventId")
  @@index([circleId], map: "idx_UsageEventCircle_circleId")
}

model Session {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  memberId        String?        @db.Uuid
  pendingSignInId String?        @db.Uuid
  tokenHash       String         @unique
  lastSeenAtUtc   DateTime       @default(now())
  expiresAtUtc    DateTime
  userAgentLabel  String?
  returnPath      String         @default("/")
  createdAtUtc    DateTime       @default(now())
  updatedAtUtc    DateTime       @updatedAt
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pendingSignIn   PendingSignIn? @relation(fields: [pendingSignInId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "idx_Session_memberId")
  @@index([pendingSignInId], map: "idx_Session_pendingSignInId")
  @@index([expiresAtUtc], map: "idx_Session_expiresAtUtc")
}

model PrivacyNoticeVersion {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version         Int       @unique
  text            String
  isMaterialChange Boolean
  publishedAtUtc  DateTime?
  createdAtUtc    DateTime  @default(now())
  updatedAtUtc    DateTime  @updatedAt
  consents        Consent[]
}

model Consent {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  memberId               String               @db.Uuid
  privacyNoticeVersionId String               @db.Uuid
  contactEmail           String
  acceptedAtUtc          DateTime             @default(now())
  createdAtUtc           DateTime             @default(now())
  updatedAtUtc           DateTime             @updatedAt
  member                 Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  privacyNoticeVersion   PrivacyNoticeVersion @relation(fields: [privacyNoticeVersionId], references: [id])

  @@unique([memberId, privacyNoticeVersionId])
  @@index([memberId], map: "idx_Consent_memberId")
  @@index([privacyNoticeVersionId], map: "idx_Consent_privacyNoticeVersionId")
}
