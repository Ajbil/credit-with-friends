DATABASE_URL=postgresql://postgres:postgres@localhost:5433/credit_with_friends
PORT=3000
# Trusted reverse proxy hops; production on Render uses 1.
TRUST_PROXY=0
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_CONTACT_EMAIL=owner@example.in

# Google OAuth web client. The callback URL is API_ORIGIN/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Set after your own sign-in; shown in your profile by the web app.
OWNER_GOOGLE_ACCOUNT_ID=
# Keep false until launch. Comma-separated verified Google emails are allowed before launch.
LAUNCH_OPEN=false
PRELAUNCH_ALLOWED_EMAILS=owner@example.in
# Local/CI only. The route is absent when NODE_ENV=production.
TEST_AUTH_ENABLED=false
