DATABASE_URL=postgresql://postgres:postgres@localhost:5433/credit_with_friends
PORT=3000
# Trusted reverse proxy hops; production on Render uses 1.
TRUST_PROXY=0
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_CONTACT_EMAIL=owner@example.in

# Optional until the accounts task.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GOOGLE_ACCOUNT_ID=
LAUNCH_OPEN=false
PRELAUNCH_ALLOWED_EMAILS=
TEST_AUTH_ENABLED=false
